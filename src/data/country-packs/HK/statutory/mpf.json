{
  "general": {
    "code": "MPF",
    "name": "Mandatory Provident Fund (MPF)",
    "description": "Mandatory contributions under the MPF Schemes Ordinance: employee and employer each pay 5% of relevant income. Below the minimum relevant income (HK$7,100 a month) only the employer pays; above the maximum (HK$30,000 a month) each pays a fixed HK$1,500.",
    "agency": "MPFA",
    "type": "pension",
    "version": "2026.1",
    "effectiveDate": "2014-06-01",
    "status": "published"
  },
