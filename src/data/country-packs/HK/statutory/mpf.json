    "minimumAge": 18,
    "maximumAge": 64,
    "excludedCategories": [],
    "employeeExemptFirstDays": 30,
    "notes": "Employees aged 18 to 64 employed for 60 days or more (casual workers in construction and catering from day one). Exempt: people covered by an overseas retirement scheme, or in Hong Kong to work for 13 months or less (choose 'Exempt from MPF'). New employees do not pay their share for the first 30 days and the incomplete pay period after that; the employer pays from the first day."
  },
