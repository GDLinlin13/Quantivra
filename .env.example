# Browser-visible (bundled into the app). Safe to expose: RLS protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only: used by /api/admin-users (Vercel function, and `npm run dev`).
# NEVER prefix with VITE_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
